# Server
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Public address of the web app, used in shared links (defaults to CLIENT_URL)
PUBLIC_APP_URL=

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudledger

# Auth - REQUIRED. Use a long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=
JWT_EXPIRES_IN=1d

# SMTP (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional sender address (defaults to SMTP_USER)
SMTP_FROM=

# Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_AUTO_ENABLED=false
BACKUP_SCHEDULE_DAILY=0 2 * * *
BACKUP_CLEANUP_SCHEDULE=0 3 * * *

# Optional: key used to encrypt stored API tokens (defaults to JWT_SECRET)
SECRETS_KEY=
