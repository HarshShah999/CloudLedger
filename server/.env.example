# Server
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Public address of the web app, used in shared links (defaults to CLIENT_URL)
PUBLIC_APP_URL=

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudledger

# Auth - REQUIRED. Use a long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=
# Sessions: short-lived access token + rotating refresh token, both in httpOnly cookies
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Cookies are HTTPS-only when NODE_ENV=production; set COOKIE_SECURE=false only for local HTTP testing
# COOKIE_SECURE=true

# SMTP: used for invoice emails, payment reminders and password reset links.
# Gmail/Google Workspace: smtp.gmail.com, port 587, your address and an App Password.
# Transactional services (Brevo, Amazon SES, Zoho ZeptoMail, Resend...) give better delivery for a live app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional sender address (defaults to SMTP_USER)
SMTP_FROM=

# Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_AUTO_ENABLED=false
BACKUP_SCHEDULE_DAILY=0 2 * * *
BACKUP_CLEANUP_SCHEDULE=0 3 * * *
# Folder holding pg_dump/psql if they are not on PATH (Windows installs are found automatically)
PG_BIN_DIR=

# Logging and monitoring
# trace | debug | info | warn | error (JSON lines on stdout)
LOG_LEVEL=info
# Slack/Teams/Google Chat incoming webhook (or any JSON endpoint) for server errors and failed jobs
ERROR_WEBHOOK_URL=
# Shown by /api/health
APP_VERSION=

# Optional: key used to encrypt stored API tokens (defaults to JWT_SECRET)
SECRETS_KEY=
